# Ophanim Core local development environment template.
# Copy to `.env` and fill in local values. Never commit real secrets.
# All variables use the OPHANIM_ prefix.

# Runtime identity used by the local control plane.
OPHANIM_ENVIRONMENT=development
OPHANIM_SERVICE_NAME=ophanim-core
OPHANIM_RUNTIME_TENANT_ID=00000000-0000-0000-0000-000000000001
OPHANIM_RUNTIME_WORKSPACE_ID=00000000-0000-0000-0000-000000000002
OPHANIM_DESKTOP_API_TOKEN=dev-token-123

# CORS for the local desktop/web UI.
OPHANIM_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173

# Local model provider (LM Studio or an Ollama OpenAI-compatible endpoint).
OPHANIM_LMSTUDIO_BASE_URL=http://localhost:1234/v1
OPHANIM_LMSTUDIO_MODEL=
OPHANIM_LMSTUDIO_CONTEXT_WINDOW=32768
OPHANIM_LMSTUDIO_CAPABILITIES=chat
OPHANIM_REQUEST_TIMEOUT_SECONDS=120

# Cloud providers: leave model fields empty to disable.
OPHANIM_OPENAI_MODEL=
OPHANIM_GEMINI_MODEL=
OPHANIM_ANTHROPIC_MODEL=

# Browser automation (optional).
OPHANIM_BROWSER_ENABLED=false

# Diagnostic sources consumed by R1-14 tools and the R1-15 skill.
OPHANIM_DIAGNOSTICS_DB_DSN=
OPHANIM_DIAGNOSTICS_LOG_PATH=

# Observability.
OPHANIM_LOG_LEVEL=INFO
OPHANIM_LOG_PATH=
OPHANIM_METRICS_ENABLED=true
OPHANIM_OTEL_ENABLED=false
OPHANIM_OTEL_OTLP_ENDPOINT=http://localhost:4318
OPHANIM_READYZ_TIMEOUT_SECONDS=3.0
# Comma-separated components that must report ok for /readyz to be ready.
OPHANIM_READYZ_REQUIRED_COMPONENTS=
