# Ophanim Core configuration
# S00-T01 performs a clean pre-release namespace rename. Legacy-prefixed variables
# are not read; update local .env files to the OPHANIM_* namespace.
OPHANIM_ENVIRONMENT=development
OPHANIM_ANYTHINGLLM_BASE_URL=http://localhost:3001
OPHANIM_ANYTHINGLLM_API_KEY=
OPHANIM_LMSTUDIO_BASE_URL=http://localhost:1234/v1
OPHANIM_LMSTUDIO_API_KEY=
OPHANIM_REQUEST_TIMEOUT_SECONDS=10

# Browser agent is disabled until explicitly enabled.
OPHANIM_BROWSER_ENABLED=false
OPHANIM_BROWSER_HEADLESS=false
OPHANIM_BROWSER_MODEL=
OPHANIM_BROWSER_MAX_STEPS=20
OPHANIM_BROWSER_ALLOWED_DOMAINS=
OPHANIM_BROWSER_REQUIRE_APPROVAL_FOR_WRITES=true
