# Current runtime compatibility
# The existing legacy core still reads NEXUVO_* variables. Sprint 00 task S00-T01 will
# rename the first-party service/package and migrate these to OPHANIM_* without changing behavior.
NEXUVO_ENVIRONMENT=development
NEXUVO_ANYTHINGLLM_BASE_URL=http://localhost:3001
NEXUVO_ANYTHINGLLM_API_KEY=
NEXUVO_LMSTUDIO_BASE_URL=http://localhost:1234/v1
NEXUVO_LMSTUDIO_API_KEY=
NEXUVO_REQUEST_TIMEOUT_SECONDS=10

# Browser agent is disabled until explicitly enabled.
NEXUVO_BROWSER_ENABLED=false
NEXUVO_BROWSER_HEADLESS=false
NEXUVO_BROWSER_MODEL=
NEXUVO_BROWSER_MAX_STEPS=20
NEXUVO_BROWSER_ALLOWED_DOMAINS=
NEXUVO_BROWSER_REQUIRE_APPROVAL_FOR_WRITES=true

# Target variable namespace after S00-T01:
# OPHANIM_ENVIRONMENT=development
# OPHANIM_ANYTHINGLLM_BASE_URL=http://localhost:3001
# OPHANIM_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# OPHANIM_BROWSER_ENABLED=false
