# Ophanim Core configuration
# S00-T01 performs a clean pre-release namespace rename. Legacy-prefixed variables
# are not read; update local .env files to the OPHANIM_* namespace.
OPHANIM_ENVIRONMENT=development
OPHANIM_ANYTHINGLLM_BASE_URL=http://localhost:3001
OPHANIM_ANYTHINGLLM_API_KEY=
OPHANIM_LMSTUDIO_BASE_URL=http://localhost:1234/v1
OPHANIM_LMSTUDIO_API_KEY=
OPHANIM_REQUEST_TIMEOUT_SECONDS=10

# Governed cloud-model adapters are disabled until a model ID is configured.
# Keep credential VALUES in the process environment or a future approved secret
# provider. These *_REF variables name the allowlisted process variables to read.
OPHANIM_CLOUD_MODEL_TIMEOUT_SECONDS=30
OPHANIM_CLOUD_MODEL_MAX_RETRIES=1
OPHANIM_CLOUD_MODEL_RETRY_BACKOFF_SECONDS=0.25
OPHANIM_CLOUD_MODEL_MAX_MESSAGES=100
OPHANIM_CLOUD_MODEL_MAX_INPUT_CHARS=200000
OPHANIM_CLOUD_MODEL_MAX_OUTPUT_TOKENS=8192
OPHANIM_OPENAI_API_KEY_REF=OPHANIM_OPENAI_API_KEY
OPHANIM_OPENAI_MODEL=
OPHANIM_OPENAI_CONTEXT_WINDOW=1
OPHANIM_OPENAI_CAPABILITIES=chat
OPHANIM_GEMINI_API_KEY_REF=OPHANIM_GEMINI_API_KEY
OPHANIM_GEMINI_MODEL=
OPHANIM_GEMINI_CONTEXT_WINDOW=1
OPHANIM_GEMINI_CAPABILITIES=chat
OPHANIM_ANTHROPIC_API_KEY_REF=OPHANIM_ANTHROPIC_API_KEY
OPHANIM_ANTHROPIC_MODEL=
OPHANIM_ANTHROPIC_CONTEXT_WINDOW=1
OPHANIM_ANTHROPIC_CAPABILITIES=chat
OPHANIM_ANTHROPIC_API_VERSION=2023-06-01

# Browser agent is disabled until explicitly enabled.
OPHANIM_BROWSER_ENABLED=false
OPHANIM_BROWSER_HEADLESS=false
OPHANIM_BROWSER_MODEL=
OPHANIM_BROWSER_MAX_STEPS=20
OPHANIM_BROWSER_ALLOWED_DOMAINS=
OPHANIM_BROWSER_REQUIRE_APPROVAL_FOR_WRITES=true
